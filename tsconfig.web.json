{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "composite": true,
    "skipLibCheck": true
  },
  "include": [
    "login-pilot/src/renderer/src/**/*.ts",
    "login-pilot/src/renderer/src/**/*.tsx",
    "login-pilot/src/shared/**/*.ts",
    "native-login-pilot/src/renderer/src/**/*.ts",
    "native-login-pilot/src/renderer/src/**/*.tsx",
    "native-login-pilot/src/shared/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/time.ts"
  ]
}
